{
  "name": "qa-automation",
  "version": "1.0.0",
  "description": "Playwright + Claude MCP QA automation framework",
  "private": true,
  "scripts": {
    "setup": "playwright install chromium webkit",
    "test": "playwright test",
    "test:web": "playwright test --project=web-chrome",
    "test:mobile-web": "playwright test --project=mobile-web-android --project=mobile-web-ios",
    "test:android": "playwright test --project=android-app",
    "test:ios": "playwright test --project=ios-app",
    "test:api": "playwright test --project=api",
    "test:a11y": "playwright test --grep @a11y",
    "test:visual": "playwright test --grep @visual",
    "test:perf": "playwright test --grep @perf --workers=1",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "visual:update": "playwright test --update-snapshots",
    "flaky:check": "playwright test --repeat-each=10 --retries=0",
    "test:headed": "playwright test --project=web-chrome --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --project=web-chrome --debug",
    "codegen": "playwright codegen",
    "allure:clean": "node -e \"require('fs').rmSync('allure-report',{recursive:true,force:true})\"",
    "allure:generate": "npm run allure:clean && allure generate allure-results",
    "allure:open": "allure open allure-report",
    "report": "npm run allure:generate && allure open allure-report",
    "report:html": "playwright show-report",
    "reports": "node scripts/open-reports.mjs",
    "typecheck": "tsc --noEmit",
    "auth": "playwright test --project=setup",
    "mail:check": "node scripts/mail-check.mjs",
    "demo:email": "playwright test --project=api --grep @demo",
    "new:app": "node scripts/new-app.mjs",
    "coverage:tc": "node scripts/tc-coverage.mjs",
    "req:status": "node scripts/req-track.mjs status",
    "req:diff": "node scripts/req-track.mjs diff",
    "req:baseline": "node scripts/req-track.mjs baseline",
    "docs:pdf": "node docs/build-pdf.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "allure": "^3.20.0",
    "allure-js-commons": "^3.13.0",
    "allure-playwright": "^3.13.0",
    "dotenv": "^18.0.5",
    "imapflow": "^2.2.6",
    "mailparser": "^3.9.36",
    "nodemailer": "^10.0.15",
    "typescript": "^7.0.2",
    "webdriverio": "^9.32.0",
    "zod": "^4.6.5"
  }
}
