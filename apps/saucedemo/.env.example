# SauceDemo settings. Copy to `.env` (or `.env.staging` etc. for other environments).
# QA test accounts only — never production credentials. Never commit .env files.

# ── Web (override app.config.ts defaults per environment) ──
# BASE_URL=https://www.saucedemo.com
# TEST_ID_ATTRIBUTE=data-test

# Accounts per role (names referenced in app.config.ts → auth.roles)
WEB_USERNAME=standard_user
WEB_PASSWORD=secret_sauce
PROBLEM_USERNAME=problem_user

# ── API (setup / cleanup) ──
# API_BASE_URL=
# API_TOKEN=

# ── Test mailbox (OTP / verification emails, mailbox fixture) ──
# Dedicated QA Gmail, not a personal one.
# Gmail: 2-step verification on, then an app password. Check with: npm run mail:check
# MAIL_USER=qa.mysite@gmail.com
# MAIL_PASSWORD=
# MAIL_IMAP_HOST=imap.gmail.com      (Outlook: outlook.office365.com)
# MAIL_WAIT_SECONDS=60
# Only for npm run demo:email (the demo sends its practice emails through this): Gmail default
# MAIL_SMTP_HOST=smtp.gmail.com
# MAIL_SMTP_PORT=465

# ── Mobile (Appium) ──
APPIUM_URL=http://127.0.0.1:4723
MOBILE_USERNAME=
MOBILE_PASSWORD=

# Android: ANDROID_APP (path to .apk) OR ANDROID_APP_PACKAGE + ANDROID_APP_ACTIVITY (installed app)
ANDROID_DEVICE=emulator-5554
ANDROID_VERSION=
ANDROID_APP=
ANDROID_APP_PACKAGE=
ANDROID_APP_ACTIVITY=

# iOS (macOS only): IOS_APP (path to .app/.ipa) OR IOS_BUNDLE_ID (installed app)
IOS_DEVICE=iPhone 15
IOS_VERSION=
IOS_APP=
IOS_BUNDLE_ID=
