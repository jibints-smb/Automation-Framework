# Root settings, shared by all apps. Copy to `.env`.
# App-specific settings (URLs, accounts, app builds) go in apps/<app>/.env

# Which app to test (folder name under apps/). Can also be set per command: APP=shop npm test
APP=saucedemo

# Environment: loads apps/<app>/.env.<TEST_ENV> before apps/<app>/.env
TEST_ENV=qa

# You, the QA running the tests: shown as "Tested by" in the report header, the Environment section, each test's
# Owner and the saved-runs list; also recorded by req:baseline. Empty: your git user name is used.
QA_NAME=
# Optional, shown next to the name in the report's Environment section
QA_EMAIL=

# The build under test and its sprint/release: shown in every report and saved run, used by npm run sprint:report.
# Set them when a new build arrives (or on the command line / in CI).
BUILD_VERSION=
RELEASE=
SPRINT=

# Optional: post a short summary of every saved run to a Teams or Slack incoming webhook
# (counts, build, new failures, where the report is; never test data or secrets)
NOTIFY_WEBHOOK=

# Jira links in the Allure report, e.g. https://yourcompany.atlassian.net
JIRA_BASE_URL=

# Report history: every run's report is saved in reports/<app>/ (npm run reports opens the list).
# REPORT_ARCHIVE=off        turn saving off (e.g. while debugging one test over and over)
# REPORT_KEEP_DAYS=30       delete saved runs older than N days; 0 = keep forever
# REPORT_KEEP_RUNS=50       keep at most N runs per app (newest); 0 = no limit
# (npm run flaky:check runs are never saved)
REPORT_ARCHIVE=on
REPORT_KEEP_DAYS=30
REPORT_KEEP_RUNS=50
# Kept of failed tests next to each saved report (evidence/): video (default) | trace | none
# trace = Playwright trace too: it records typed passwords and session cookies, keep it inside the QA team
REPORT_EVIDENCE=video
